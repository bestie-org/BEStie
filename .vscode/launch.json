					}
				]
			}
		},
		{
			"name": "Release nRF52840",
			"request": "launch",
			"type": "cortex-debug",
			"cwd": "${workspaceRoot}",
			"executable": "${workspaceRoot}/build/bestie_nrf52840.out",
			"servertype": "jlink",
			"device": "nRF52840_xxAA",
			"interface": "swd",
			"preLaunchTask": "Build nRF52840 (Release)",
			"svdFile": "${workspaceRoot}/external/nRF5_SDK/modules/nrfx/mdk/nrf52840.svd",
			"runToEntryPoint": "main",
			"rttConfig": {
				"enabled": true,
				"address": "auto",
				"decoders": [
					{
						"label": "Channel 0",
						"port": 0,
						"type": "console"
					}
				]
			}
		}
	]
}
